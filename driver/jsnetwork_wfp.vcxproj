<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ProjectGuid>{D4E5F6A7-B8C9-0D1E-2F3A-4B5C6D7E8F90}</ProjectGuid>
    <RootNamespace>JsNetworkWfp</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>jsnetwork_wfp</ProjectName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <!-- Try WDK toolset first, fall back to v142 with manual kernel settings -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <PlatformToolset Condition="exists('$(MSBuildExtensionsPath)\Microsoft\VC\v160\Drivers\WindowsKernelModeDriver10.0.props')">WindowsKernelModeDriver10.0</PlatformToolset>
    <PlatformToolset Condition="!exists('$(MSBuildExtensionsPath)\Microsoft\VC\v160\Drivers\WindowsKernelModeDriver10.0.props')">v142</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <PlatformToolset Condition="exists('$(MSBuildExtensionsPath)\Microsoft\VC\v160\Drivers\WindowsKernelModeDriver10.0.props')">WindowsKernelModeDriver10.0</PlatformToolset>
    <PlatformToolset Condition="!exists('$(MSBuildExtensionsPath)\Microsoft\VC\v160\Drivers\WindowsKernelModeDriver10.0.props')">v142</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <DebuggerFlavor>DbgengKernelDebugger</DebuggerFlavor>
    <Inf2CatUseLocalTime>true</Inf2CatUseLocalTime>
  </PropertyGroup>

  <!-- Kernel-mode include/lib paths -->
  <PropertyGroup>
    <WDKPath Condition="'$(WDKPath)'==''">C:\Program Files (x86)\Windows Kits\10</WDKPath>
    <WDKVersion Condition="'$(WDKVersion)'==''">10.0.22621.0</WDKVersion>
    <WDKIncPath>$(WDKPath)\Include\$(WDKVersion)</WDKIncPath>
    <WDKLibPath>$(WDKPath)\Lib\$(WDKVersion)</WDKLibPath>
  </PropertyGroup>

  <!-- Fallback v142 kernel-mode settings (when WDK VS extension not installed) -->
  <ItemDefinitionGroup Condition="'$(PlatformToolset)'=='v142'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions>_WIN64;NDIS60;KERNEL_MODE;_NT_KERNEL_MODE_;_AMD64_;NT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(WDKIncPath)\km;$(WDKIncPath)\shared;$(SolutionDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <SDLCheck>false</SDLCheck>
      <TreatWarningAsError>false</TreatWarningAsError>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <ExceptionHandling>false</ExceptionHandling>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>ntoskrnl.lib;hal.lib;wmilib.lib;fltMgr.lib;fwpkclnt.lib;uuid.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(WDKLibPath)\km\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <SubSystem>Native</SubSystem>
      <Driver>Driver</Driver>
      <EntryPoint>DriverEntry</EntryPoint>
    </Link>
  </ItemDefinitionGroup>

  <!-- Debug x64 (WDK toolset) -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64' And '$(PlatformToolset)'!='v142'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;_WIN64;NDIS60;KERNEL_MODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(SolutionDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <SDLCheck>true</SDLCheck>
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);ndis.lib;ntoskrnl.lib;hal.lib;wmilib.lib;fltMgr.lib;fwpkclnt.lib;uuid.lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- Release x64 (WDK toolset) -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64' And '$(PlatformToolset)'!='v142'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>NDEBUG;_WIN64;NDIS60;KERNEL_MODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(SolutionDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <SDLCheck>true</SDLCheck>
      <TreatWarningAsError>false</TreatWarningAsError>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);ndis.lib;ntoskrnl.lib;hal.lib;wmilib.lib;fltMgr.lib;fwpkclnt.lib;uuid.lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="jsnetwork_wfp.c" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="jsnetwork_wfp.h" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="jsnetwork_wfp.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- Post-build: link .obj to .sys when using v142 fallback -->
  <Target Name="LinkKernelDriver" AfterTargets="ClCompile" Condition="'$(PlatformToolset)'=='v142'">
    <Exec Command="&quot;$(VCToolsInstallDir)bin\HostX64\x64\link.exe&quot; /OUT:&quot;$(OutDir)$(ProjectName).sys&quot; /SUBSYSTEM:NATIVE /DRIVER /ENTRY:DriverEntry /INCREMENTAL:NO /NODEFAULTLIB /MANIFEST:NO /LIBPATH:&quot;$(WDKLibPath)\km\x64&quot; ntoskrnl.lib hal.lib wmilib.lib fltMgr.lib fwpkclnt.lib &quot;$(OutDir)$(ProjectName).obj&quot;" />
  </Target>

  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
